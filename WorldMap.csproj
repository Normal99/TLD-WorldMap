<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>WorldMap</AssemblyName>
    <RootNamespace>WorldMap</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <PathMap>$(MSBuildProjectDirectory)=/src/$(MSBuildProjectName)</PathMap>
    <TLDRevampRepoPath Condition="'$(TLDRevampRepoPath)' == ''">$(MSBuildThisFileDirectory)../tld-revamp</TLDRevampRepoPath>
    <TLDRevampMultiplayerPath Condition="'$(TLDRevampMultiplayerPath)' == ''">$(TLDRevampRepoPath)/src/TLDRevamp.Multiplayer/bin/Release/netstandard2.1/TLDRevamp.Multiplayer.dll</TLDRevampMultiplayerPath>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="$(TLDRevampRepoPath)/lib/*.dll" Private="false" />
    <Reference Include="TLDRevamp.Multiplayer" Private="false">
      <HintPath>$(TLDRevampMultiplayerPath)</HintPath>
    </Reference>
  </ItemGroup>
</Project>
